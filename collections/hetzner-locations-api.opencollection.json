{
  "opencollection": "1.0.0",
  "info": {
    "name": "Hetzner Cloud Actions Locations API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Locations",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List Locations",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.hetzner.cloud/v1/locations",
            "params": [
              {
                "name": "name",
                "value": "",
                "type": "query",
                "description": "Filter resources by their name.\n\nThe response will only contain the resources\nmatching exactly the specified name.\n"
              },
              {
                "name": "sort",
                "value": "",
                "type": "query",
                "description": "Sort resources by field and direction. May be used multiple times.\n\nFor more information, see \"[Sorting](#description/sorting)\".\n"
              },
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "Page number to return. For more information, see \"[Pagination](#description/pagination)\"."
              },
              {
                "name": "per_page",
                "value": "",
                "type": "query",
                "description": "Maximum number of entries returned per page. For more information, see \"[Pagination](#description/pagination)\"."
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Returns all [Locations](#tag/locations).\n"
        },
        {
          "info": {
            "name": "Get a Location",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.hetzner.cloud/v1/locations/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "ID of the Location."
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Returns a [Location](#tag/locations).\n"
        }
      ]
    }
  ],
  "bundled": true
}