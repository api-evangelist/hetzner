          "http": {
            "method": "GET",
            "url": "https://api.hetzner.cloud/v1/certificates/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "ID of the Certificate."
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
